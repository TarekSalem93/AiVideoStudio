<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AiVideoStudio.Views.ProjectsPage"
             Title="Projects">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Projects" FontSize="24" HorizontalOptions="Center" />
        <HorizontalStackLayout Spacing="10">
            <Entry x:Name="TitleEntry" Placeholder="New project title" HorizontalOptions="FillAndExpand" />
            <Button Text="Add" Clicked="OnAddClicked" />
        </HorizontalStackLayout>
        <Label x:Name="EmptyLabel" Text="No projects yet." FontSize="14" TextColor="Gray" HorizontalOptions="Center" />
        <CollectionView x:Name="ProjectsView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Created, StringFormat='{0:yyyy-MM-dd HH:mm}'}" FontSize="12" TextColor="Gray" />
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Open" Clicked="OnOpenClicked" />
                                <Button Text="Delete" Clicked="OnDeleteClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
