<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AiVideoStudio.Views.MainPage"
             Title="Studio">
    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="4">
            <Label Text="AI Video Studio" Style="{StaticResource PageTitle}" />
            <Label Text="Story to film, powered by Ollama + MiniMax H3" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Pill}">
                <Label x:Name="HealthLabel" Text="Checking servers..." Style="{StaticResource Muted}" HorizontalOptions="Center" />
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="SETUP" Style="{StaticResource SectionTitle}" />
                    <Label Text="Model" Style="{StaticResource Muted}" />
                    <Picker x:Name="ModelPicker" Title="Pick Ollama model" />
                    <Label Text="Workflow template" Style="{StaticResource Muted}" />
                    <Picker x:Name="TemplatePicker" Title="Pick ComfyUI template" />
                    <Label Text="Steps" Style="{StaticResource Muted}" />
                    <Entry x:Name="StepsEntry" Keyboard="Numeric" Text="6" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="REFERENCE MEDIA" Style="{StaticResource SectionTitle}" />
                    <Button Text="Pick photos (up to 9)" Style="{StaticResource GhostButton}" Clicked="OnPickPhotosClicked" />
                    <Label x:Name="PhotosLabel" Text="No photos selected." Style="{StaticResource Muted}" />
                    <Button Text="Pick videos (up to 3)" Style="{StaticResource GhostButton}" Clicked="OnPickVideosClicked" />
                    <Label x:Name="VideosLabel" Text="No videos selected." Style="{StaticResource Muted}" />
                    <Button Text="Pick audios (up to 3)" Style="{StaticResource GhostButton}" Clicked="OnPickAudiosClicked" />
                    <Label x:Name="AudiosLabel" Text="No audios selected." Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="STORY" Style="{StaticResource SectionTitle}" />
                    <Entry x:Name="PromptEntry"
                           Placeholder="e.g. a robot learning to paint, cinematic..."
                           Text="Write a 3-scene story about a robot learning to paint" />
                    <Button Text="Generate Story" Style="{StaticResource PrimaryButton}" Clicked="OnGenerateClicked" />
                    <Editor x:Name="ResponseEditor"
                            Placeholder="Generated story lands here — fix whatever you want, video uses this text."
                            AutoSize="TextChanges"
                            MinimumHeightRequest="150"
                            FontSize="16" />
                    <Button Text="Build H3 Video Prompt" Style="{StaticResource GhostButton}" Clicked="OnBuildPromptClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="VIDEO" Style="{StaticResource SectionTitle}" />
                    <Button Text="Generate Video" Style="{StaticResource PrimaryButton}" Clicked="OnVideoClicked" />
                    <Button Text="Open last video" Style="{StaticResource GhostButton}" Clicked="OnOpenClicked" />
                    <Button Text="Dub Arabic voiceover" Style="{StaticResource GhostButton}" Clicked="OnDubClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="PUBLISH" Style="{StaticResource SectionTitle}" />
                    <Entry x:Name="TitleEntry" Placeholder="Video title" Text="AiVideoStudio" />
                    <HorizontalStackLayout Spacing="6">
                        <CheckBox x:Name="YouTubeCheck" VerticalOptions="Center" /><Label Text="YouTube" VerticalOptions="Center" />
                        <CheckBox x:Name="TikTokCheck" VerticalOptions="Center" /><Label Text="TikTok" VerticalOptions="Center" />
                        <CheckBox x:Name="FacebookCheck" VerticalOptions="Center" /><Label Text="Facebook" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Text="Publish" Style="{StaticResource PrimaryButton}" Clicked="OnPublishClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="SYSTEM" Style="{StaticResource SectionTitle}" />
                    <Button Text="Check / Start ComfyUI" Style="{StaticResource GhostButton}" Clicked="OnComfyClicked" />
                    <Label x:Name="StatusLabel" Text="" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
