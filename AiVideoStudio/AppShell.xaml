<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AiVideoStudio.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AiVideoStudio.Views"
    Title="AiVideoStudio">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Projects"
            ContentTemplate="{DataTemplate local:ProjectsPage}"
            Route="ProjectsPage" />

        <ShellContent
            Title="History"
            ContentTemplate="{DataTemplate local:SceneEditorPage}"
            Route="SceneEditorPage" />

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
